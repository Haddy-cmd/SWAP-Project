%%{init: {"theme": "neutral"}}%%
%% Figure 3.9 Entity-Relationship Diagram of SWAP: the tables the system works with and their key
%% columns (names as in the database). Left out: notifications, audit logs, verification history,
%% stipend signatures and other support tables.
%% Paste into https://mermaid.live and export PNG/SVG.
erDiagram
    users {
        int id PK
        string name
        string email
        string role "applicant, recipient, supervisor, admin"
        int office_id FK "supervisors"
        boolean is_active
    }
    student_profiles {
        int id PK
        int user_id FK
        string student_id_number
        string college
        string program
        int year_level
    }
    applications {
        int id PK
        int user_id FK
        string type "new, renewal"
        string academic_year
        string semester
        string status
    }
    application_documents {
        int id PK
        int application_id FK
        string document_type
        string file_path
    }
    interviews {
        int id PK
        int application_id FK
        datetime scheduled_at
        string mode "in_person, online"
        string status
    }
    semester_periods {
        int id PK
        string academic_year
        string semester
        date start_date
        date end_date
        boolean renewal_open
    }
    offices {
        int id PK
        string name
        decimal latitude
        decimal longitude
        int radius_meters
        int max_recipients
    }
    assignments {
        int id PK
        int user_id FK "recipient"
        int office_id FK
        int supervisor_id FK
        string academic_year
        string semester
        int required_hours
        string term_status "qualified, deficient"
    }
    time_logs {
        int id PK
        int assignment_id FK
        datetime time_in
        datetime time_out
        decimal duration_hours
        string status "pending, verified, rejected"
    }
    narrative_reports {
        int id PK
        int time_log_id FK
        text content
        text activities_done
    }
    term_reports {
        int id PK
        int assignment_id FK
        text content
        string file_path
        boolean renewal_eligible
    }
    promissory_notes {
        int id PK
        int assignment_id FK
        decimal lacking_hours
        string file_path
        string status
    }
    stipend_history {
        int id PK
        int user_id FK
        int promissory_note_id FK
        decimal amount
        string control_number
        string status "released, void"
    }
    announcements {
        int id PK
        int sent_by FK
        int office_id FK
        string title
        string audience
    }
    concerns {
        int id PK
        int user_id FK
        string subject
        string status
    }

    users ||--o| student_profiles : has
    users ||--o{ applications : submits
    applications ||--o{ application_documents : includes
    applications ||--o| interviews : "scheduled for"
    offices ||--o{ users : "has supervisors"
    users ||--o{ assignments : "placed in / supervises"
    offices ||--o{ assignments : hosts
    semester_periods ||..o{ assignments : "term of"
    assignments ||--o{ time_logs : records
    time_logs ||--o| narrative_reports : "described by"
    assignments ||--o| term_reports : "ends with"
    assignments ||--o{ promissory_notes : "may have"
    users ||--o{ stipend_history : receives
    promissory_notes |o--o{ stipend_history : "released via"
    users ||--o{ announcements : sends
    offices |o--o{ announcements : "sent to"
    users ||--o{ concerns : raises
